PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/futetrends
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Optional API-Football integration
APIFOOTBALL_API_KEY=
APIFOOTBALL_BRAZIL_LEAGUE_ID=71
APIFOOTBALL_SEASON=2026
APIFOOTBALL_CACHE_TTL_MS=60000

# Used by npm run create-admin
ADMIN_NAME=FuteTrends Admin
ADMIN_EMAIL=admin@futetrends.com
ADMIN_PASSWORD=change-this-password
